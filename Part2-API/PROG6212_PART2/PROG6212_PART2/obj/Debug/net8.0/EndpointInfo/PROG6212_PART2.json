  "components": {
    "schemas": {
      "Category": {
        "required": [
          "distance",
          "eventId",
          "name"
        ],
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "integer",
            "format": "int32"
          },
          "eventId": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "distance": {
            "type": "number",
            "format": "double"
          },
          "maxParticipants": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "event": {
            "$ref": "#/components/schemas/Event"
          },
          "enrolments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Enrolment"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Enrolment": {
        "required": [
          "categoryId",
          "participantId",
          "status"
        ],
        "type": "object",
        "properties": {
          "enrolmentId": {
            "type": "integer",
            "format": "int32"
          },
          "participantId": {
            "type": "integer",
            "format": "int32"
          },
          "categoryId": {
            "type": "integer",
            "format": "int32"
          },
          "enrolmentDate": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          },
          "participant": {
            "$ref": "#/components/schemas/User"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "result": {
            "$ref": "#/components/schemas/Result"
          }
        },
        "additionalProperties": false
      },
      "Event": {
        "required": [
          "distance",
          "eventDate",
          "eventType",
          "location",
          "name",
          "organiserId"
        ],
        "type": "object",
        "properties": {
          "eventId": {
            "type": "integer",
            "format": "int32"
          },
          "organiserId": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "maxLength": 1000,
            "type": "string",
            "nullable": true
          },
          "eventDate": {
            "type": "string",
            "format": "date-time"
          },
          "location": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "distance": {
            "type": "number",
            "format": "double"
          },
          "eventType": {
            "maxLength": 20,
            "minLength": 1,
            "pattern": "^(Run|Walk|Cycle)$",
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "organiser": {
            "$ref": "#/components/schemas/User"
          },
          "categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Category"
            },
            "nullable": true
          },
          "route": {
            "$ref": "#/components/schemas/Route"
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RegisterRequest": {
        "required": [
          "email",
          "fullName",
          "password",
          "role"
        ],
        "type": "object",
        "properties": {
          "fullName": {
            "maxLength": 100,
            "minLength": 2,
            "type": "string"
          },
          "email": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string",
            "format": "email"
          },
          "password": {
            "maxLength": 100,
            "minLength": 8,
            "type": "string"
          },
          "role": {
            "minLength": 1,
            "pattern": "^(Organiser|Participant)$",
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Result": {
        "required": [
          "capturedByOrganiserId",
          "enrolmentId",
          "finishTime"
        ],
        "type": "object",
        "properties": {
          "resultId": {
            "type": "integer",
            "format": "int32"
          },
          "enrolmentId": {
            "type": "integer",
            "format": "int32"
          },
          "finishTime": {
            "type": "string",
            "format": "date-span"
          },
          "position": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "capturedByOrganiserId": {
            "type": "integer",
            "format": "int32"
          },
          "enrolment": {
            "$ref": "#/components/schemas/Enrolment"
          },
          "capturedByOrganiser": {
            "$ref": "#/components/schemas/User"
          }
        },
        "additionalProperties": false
      },
      "Route": {
        "required": [
          "distanceKm",
          "endLocation",
          "eventId",
          "startLocation"
        ],
        "type": "object",
        "properties": {
          "routeId": {
            "type": "integer",
            "format": "int32"
          },
          "eventId": {
            "type": "integer",
            "format": "int32"
          },
          "startLocation": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "endLocation": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "distanceKm": {
            "type": "number",
            "format": "double"
          },
          "elevationGain": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "routeDescription": {
            "maxLength": 1000,
            "type": "string",
            "nullable": true
          },
          "event": {
            "$ref": "#/components/schemas/Event"
          }
        },
        "additionalProperties": false
      },
      "UpdateProfileRequest": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "newPassword": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "User": {
        "required": [
          "email",
          "fullName",
          "passwordHash",
          "role"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int32"
          },
          "fullName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "passwordHash": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "role": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "WeatherForecast": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "temperatureC": {
            "type": "integer",
            "format": "int32"
          },
          "temperatureF": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "summary": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}