@model PROG6212_PART3.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>RaceDay | Login</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>
        body {
            background: linear-gradient(135deg, #10243a, #176b63);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Arial, sans-serif;
            padding: 20px;
        }

        .login-card {
            background: white;
            padding: 40px;
            border-radius: 18px;
            width: 100%;
            max-width: 430px;
            box-shadow: 0 10px 35px rgba(0,0,0,0.2);
        }

        .brand {
            color: #176b63;
            font-weight: bold;
            font-size: 36px;
            letter-spacing: 1px;
        }

        .brand-subtitle {
            color: #777;
            font-size: 14px;
        }

        .btn-raceday {
            background: #176b63;
            color: white;
            padding: 12px;
            font-weight: bold;
            border: none;
            border-radius: 8px;
        }

            .btn-raceday:hover {
                background: #10243a;
                color: white;
            }

        .form-control {
            padding: 12px;
            border-radius: 8px;
        }

        .register-link {
            color: #176b63;
            font-weight: bold;
            text-decoration: none;
        }

            .register-link:hover {
                text-decoration: underline;
            }
    </style>
</head>

<body>

    <div class="login-card">

        <!-- RaceDay Branding -->
        <div class="text-center mb-4">
            <h1 class="brand">RaceDay</h1>
            <p class="brand-subtitle">
                Your race. Your journey. Your day.
            </p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success text-center">
                @TempData["SuccessMessage"]
            </div>
        }

        <p class="text-center text-muted mb-4">
            Sign in to continue to RaceDay.
        </p>

        <!-- Login Form -->
        <form asp-controller="Account"
              asp-action="Login"
              method="post">

            @Html.AntiForgeryToken()

            <!-- Validation Summary -->
            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <!-- Email -->
            <div class="mb-3">

                <label asp-for="Email"
                       class="form-label">
                    Email Address
                </label>

                <input asp-for="Email"
                       type="email"
                       class="form-control"
                       placeholder="Enter your email" />

                <span asp-validation-for="Email"
                      class="text-danger">
                </span>

            </div>

            <!-- Password -->
            <div class="mb-4">

                <label asp-for="Password"
                       class="form-label">
                    Password
                </label>

                <input asp-for="Password"
                       type="password"
                       class="form-control"
                       placeholder="Enter your password" />

                <span asp-validation-for="Password"
                      class="text-danger">
                </span>

            </div>

            <!-- Login Button -->
            <button type="submit"
                    class="btn btn-raceday w-100">
                Login
            </button>

        </form>

        <!-- Registration Link -->
        <div class="text-center mt-4">

            <p class="text-muted mb-0">
                Don't have an account?

                <a asp-controller="Account"
                   asp-action="Register"
                   class="register-link">
                    Register here
                </a>
            </p>

        </div>

        <!-- Footer -->
        <div class="text-center mt-4">
            <small class="text-muted">
                © 2026 RaceDay. All rights reserved.
            </small>
        </div>

    </div>

</body>
</html>
