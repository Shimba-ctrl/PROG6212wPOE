@model List<PROG6212_PART3.Models.CategoryViewModel>

@{
    ViewData["Title"] = "Manage Categories";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RaceDay | Manage Categories</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>
        body {
            background: #f4f7f8;
            font-family: Arial, sans-serif;
        }

        .navbar {
            background: #10243a;
            padding: 18px 35px;
        }

        .brand {
            color: white;
            font-size: 27px;
            font-weight: bold;
            text-decoration: none;
        }

        .page-header {
            background: linear-gradient(135deg, #176b63, #10243a);
            color: white;
            padding: 40px 35px;
        }

        .content-card {
            background: white;
            border-radius: 14px;
            padding: 25px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
        }
    </style>
</head>

<body>

    <nav class="navbar">
        <a class="brand" asp-controller="Organiser" asp-action="Index">
            RaceDay
        </a>
    </nav>

    <section class="page-header">
        <div class="container">
            <h1>Manage Categories</h1>
            <p class="lead">Create and manage your race categories.</p>
        </div>
    </section>

    <main class="container py-5">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                @TempData["ErrorMessage"]
            </div>
        }

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger">
                @ViewBag.ErrorMessage
            </div>
        }

        <div class="content-card">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4>All Categories</h4>

                <a asp-action="Create" class="btn btn-success">
                    + Create Category
                </a>
            </div>

            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info">
                    No categories have been created yet.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Category Name</th>
                                <th>Event ID</th>
                                <th>Distance</th>
                                <th>Participant Limit</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var category in Model)
                            {
                                <tr>
                                    <td>@category.Name</td>
                                    <td>@category.EventId</td>
                                    <td>@category.Distance km</td>
                                    <td>
                                        @(category.MaxParticipants?.ToString() ?? "No limit")
                                    </td>
                                    <td>
                                        <a asp-action="Edit"
                                           asp-route-id="@category.CategoryId"
                                           class="btn btn-primary btn-sm">
                                            Edit
                                        </a>

                                        <form asp-action="Delete"
                                              asp-route-id="@category.CategoryId"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this category?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-danger btn-sm">
                                                Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>

        <a asp-controller="Organiser"
           asp-action="Index"
           class="btn btn-secondary mt-4">
            Back to Dashboard
        </a>

    </main>

</body>
</html>
