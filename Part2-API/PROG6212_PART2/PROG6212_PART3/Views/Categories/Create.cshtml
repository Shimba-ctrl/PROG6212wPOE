@model PROG6212_PART3.Models.CategoryViewModel

@{
    ViewData["Title"] = "Create Category";
    Layout = null;

    var events = ViewBag.Events as List<PROG6212_PART3.Models.EventViewModel>
                 ?? new List<PROG6212_PART3.Models.EventViewModel>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RaceDay | Create Category</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
        body {
            background: #f4f7f8;
            font-family: Arial, sans-serif;
        }
        .navbar {
            background: #10243a;
            padding: 18px 35px;
        }
        .brand {
            color: white;
            font-size: 27px;
            font-weight: bold;
            text-decoration: none;
        }
        .form-card {
            background: white;
            padding: 30px;
            border-radius: 14px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <a class="brand" asp-controller="Organiser" asp-action="Index">RaceDay</a>
    </nav>

    <div class="container py-5">
        <div class="form-card">
            <h2 class="mb-4">Create Event Category</h2>
            <p class="text-muted">Add a category to one of your events.</p>

            <form asp-controller="Categories" asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label class="form-label">Select Event</label>
                    <select asp-for="EventId" class="form-select" required>
                        <option value="">-- Select an event --</option>
                        @foreach (var item in events)
                        {
                            <option value="@item.EventId">@item.Name</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Category Name</label>
                    <input asp-for="Name" class="form-control"
                           placeholder="e.g. 5km Fun Run" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Distance" class="form-label">Distance (km)</label>
                    <input asp-for="Distance" type="number" step="0.1"
                           min="0.1" class="form-control" required />
                </div>

                <div class="mb-4">
                    <label asp-for="MaxParticipants" class="form-label">
                        Maximum Participants
                    </label>
                    <input asp-for="MaxParticipants" type="number"
                           min="1" class="form-control"
                           placeholder="Leave blank for no limit" />
                </div>

                <button type="submit" class="btn btn-success">
                    Create Category
                </button>

                <a asp-action="Index" class="btn btn-secondary ms-2">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</body>
</html>
