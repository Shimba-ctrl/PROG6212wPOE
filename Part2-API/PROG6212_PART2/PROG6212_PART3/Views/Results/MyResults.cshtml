@model List<PROG6212_PART3.Models.ResultViewModel>

@{
    ViewData["Title"] = "My Results";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>RaceDay | My Results</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
        body {
            background: #f4f7f8;
            font-family: Arial, sans-serif;
        }

        .navbar {
            background: #10243a;
            padding: 18px 35px;
        }

        .brand {
            color: white;
            font-size: 27px;
            font-weight: bold;
            text-decoration: none;
        }

        .header {
            background: linear-gradient(135deg, #176b63, #10243a);
            color: white;
            padding: 35px;
        }

        .content {
            background: white;
            padding: 25px;
            border-radius: 14px;
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <a class="brand" asp-controller="Participant" asp-action="Index">RaceDay</a>
    </nav>

    <section class="header">
        <div class="container">
            <h1>My Results</h1>
            <p>View your race history and achievements.</p>
        </div>
    </section>

    <main class="container py-5">
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
        }

        <div class="content">
            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info">
                    You don't have any race results yet. Your results will appear here after an organiser records them.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Event</th>
                                <th>Category</th>
                                <th>Finish Time</th>
                                <th>Finishing Position</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var result in Model)
                            {
                                <tr>
                                    <td>@result.EventName</td>
                                    <td>@result.CategoryName</td>
                                    <td>@result.FinishTime.ToString(@"hh\:mm\:ss")</td>
                                    <td>
                                        @(result.Position.HasValue
                                                                        ? result.Position.Value.ToString()
                                                                        : "Not recorded")
                            </td>
                        </tr>
                                                }
                        </tbody>
                    </table>
                </div>
            }

            <a asp-controller="Participant" asp-action="Index"
               class="btn btn-secondary mt-3">Back to Dashboard</a>
        </div>
    </main>
</body>
</html>
