@model List<PROG6212_PART3.Models.EventViewModel>

@{
    ViewData["Title"] = "Manage Events";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>RaceDay | Manage Events</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>
        body {
            background: #f4f7f8;
            font-family: Arial, sans-serif;
        }

        .navbar {
            background: #10243a;
            padding: 18px 35px;
        }

        .brand {
            color: white;
            font-size: 27px;
            font-weight: bold;
            text-decoration: none;
        }

        .page-header {
            background: linear-gradient(135deg, #176b63, #10243a);
            color: white;
            padding: 40px 35px;
        }

        .content {
            padding: 35px;
        }

        .event-card {
            background: white;
            border-radius: 12px;
            padding: 22px;
            margin-bottom: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
        }

        .btn-raceday {
            background: #176b63;
            color: white;
            border: none;
        }

            .btn-raceday:hover {
                background: #10243a;
                color: white;
            }
    </style>
</head>

<body>

    <nav class="navbar">
        <a class="brand" href="/Organiser/Index">RaceDay</a>
    </nav>

    <section class="page-header">
        <div class="container">
            <h1>Manage Events</h1>
            <p class="mb-0">Create and manage your RaceDay events.</p>
        </div>
    </section>

    <main class="container content">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger">
                @ViewBag.ErrorMessage
            </div>
        }

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3>Your Events</h3>

            <a asp-controller="Events"
               asp-action="Create"
               class="btn btn-raceday">
                + Create Event
            </a>
        </div>

        @if (Model.Count == 0)
        {
            <div class="alert alert-info">
                You haven't created any events yet.
                Select Create Event to get started.
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="event-card">

                    <h4>@item.Name</h4>

                    <p class="text-muted">
                        @item.Description
                    </p>

                    <p>
                        <strong>Date:</strong>
                        @item.EventDate.ToString("dd MMMM yyyy")
                    </p>

                    <p>
                        <strong>Location:</strong>
                        @item.Location
                    </p>

                    <p>
                        <strong>Distance:</strong>
                        @item.Distance km
                    </p>

                    <p>
                        <strong>Event type:</strong>
                        @item.EventType
                    </p>

                    <div class="d-flex gap-2">

                        <a asp-controller="Events"
                           asp-action="Edit"
                           asp-route-id="@item.EventId"
                           class="btn btn-warning">
                            Edit
                        </a>

                        <form asp-controller="Events"
                              asp-action="Delete"
                              asp-route-id="@item.EventId"
                              method="post"
                              onsubmit="return confirm('Are you sure you want to delete this event?');">

                            @Html.AntiForgeryToken()

                            <button type="submit" class="btn btn-danger">
                                Delete
                            </button>

                        </form>

                    </div>


                </div>
            }
        }

        <a asp-controller="Organiser"
           asp-action="Index"
           class="btn btn-outline-secondary mt-3">
            Back to Dashboard
        </a>

    </main>

</body>
</html>
