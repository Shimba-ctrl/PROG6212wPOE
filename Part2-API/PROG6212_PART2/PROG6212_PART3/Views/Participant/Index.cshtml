@{
    ViewData["Title"] = "Participant Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RaceDay | Participant Dashboard</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <a asp-controller="Results" asp-action="MyResults"
       class="btn btn-primary">My Results</a>
          <style>
        body {
            background: #f4f7f8;
            font-family: Arial, sans-serif;
            margin: 0;
        }

        .navbar {
            background: #10243a;
            padding: 18px 35px;
        }

        .brand {
            color: white;
            font-size: 27px;
            font-weight: bold;
            text-decoration: none;
        }

        .welcome-section {
            background: linear-gradient(135deg, #176b63, #10243a);
            color: white;
            padding: 55px 35px;
        }

        .dashboard-content {
            padding: 35px;
        }

        .dashboard-card {
            background: white;
            border-radius: 14px;
            padding: 25px;
            height: 100%;
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
        }

            .dashboard-card h5 {
                color: #176b63;
                font-weight: bold;
            }

        .dashboard-icon {
            font-size: 30px;
            margin-bottom: 15px;
        }

        .footer {
            text-align: center;
            padding: 25px;
            color: #777;
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <a class="brand" asp-controller="Participant"
           asp-action="Index">RaceDay</a>
    </nav>

    <section class="welcome-section">
        <div class="container">
            <h1>Welcome, @ViewBag.FullName!</h1>
            <p class="lead mb-0">Your race. Your journey. Your day.</p>
        </div>
    </section>

    <main class="container-fluid dashboard-content">
        <h3 class="mb-4">Participant Dashboard</h3>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="dashboard-card">
                    <div class="dashboard-icon">🏃</div>
                    <h5>Explore Events</h5>
                    <p class="text-muted">
                        Discover upcoming races and find an event that interests you.
                    </p>
                    <a asp-controller="Participant" asp-action="Events"
                       class="btn btn-primary">Explore Events</a>
                </div>
            </div>

            <div class="col-md-4">
                <div class="dashboard-card">
                    <div class="dashboard-icon">📋</div>
                    <h5>My Enrolments</h5>
                    <p class="text-muted">
                        Keep track of the events you have enrolled in and their current status.
                    </p>
                    <a asp-controller="Participant" asp-action="Enrolments"
                       class="btn btn-primary">My Enrolments</a>
                </div>
            </div>

            <div class="col-md-4">
                <div class="dashboard-card">
                    <div class="dashboard-icon">🏆</div>
                    <h5>My Results</h5>
                    <p class="text-muted">
                        View your race history, finishing times and positions.
                    </p>
                    <a asp-controller="Participant" asp-action="Results"
                       class="btn btn-primary">My Results</a>
                </div>
            </div>
        </div>
    </main>

    <footer class="footer">
        © 2026 RaceDay. All rights reserved.
    </footer>
</body>
</html>
