@model List<PROG6212_PART3.Models.EnrolmentViewModel>

@{
    ViewData["Title"] = "My Enrolments";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RaceDay | My Enrolments</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>
        body {
            background: #f4f7f8;
            font-family: Arial, sans-serif;
        }

        .navbar {
            background: #10243a;
            padding: 18px 35px;
        }

        .brand {
            color: white;
            font-size: 27px;
            font-weight: bold;
            text-decoration: none;
        }

        .page-header {
            background: linear-gradient(135deg, #176b63, #10243a);
            color: white;
            padding: 40px 35px;
        }

        .enrolment-card {
            background: white;
            border-radius: 14px;
            padding: 25px;
            height: 100%;
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
        }

            .enrolment-card h5 {
                color: #176b63;
                font-weight: bold;
            }
    </style>
</head>

<body>

    <nav class="navbar">
        <a class="brand"
           asp-controller="Participant"
           asp-action="Index">RaceDay</a>
    </nav>

    <section class="page-header">
        <div class="container">
            <h1>My Enrolments</h1>
            <p class="lead">View and manage the events you have joined.</p>
        </div>
    </section>

    <main class="container py-5">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                @TempData["ErrorMessage"]
            </div>
        }

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger">
                @ViewBag.ErrorMessage
            </div>
        }

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info">
                You have not enrolled in any events yet.
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var item in Model)
                {
                    <div class="col-md-6">
                        <div class="enrolment-card">

                            <h5>@item.EventName</h5>

                            <p>
                                <strong>Category:</strong>
                                @item.CategoryName
                            </p>

                            <p>
                                <strong>Event Date:</strong>
                                @item.EventDate.ToString("dd MMMM yyyy HH:mm")
                            </p>

                            <p>
                                <strong>Location:</strong>
                                @(item.EventLocation ?? "Not specified")
                            </p>

                            <p>
                                <strong>Enrolment Date:</strong>
                                @item.EnrolmentDate.ToString("dd MMMM yyyy")
                            </p>

                            <p>
                                <strong>Status:</strong>

                                @if (item.Status == "Confirmed")
                                {
                                    <span class="badge bg-success">Confirmed</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.Status</span>
                                }
                            </p>

                            @if (item.Status == "Confirmed")
                            {
                                <form asp-controller="Participant"
                                      asp-action="CancelEnrolment"
                                      method="post"
                                      onsubmit="return confirm('Are you sure you want to cancel this enrolment?');">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@item.EnrolmentId" />

                                    <button type="submit"
                                            class="btn btn-danger btn-sm">
                                        Cancel Enrolment
                                    </button>
                                </form>
                            }

                        </div>
                    </div>
                }
            </div>
        }

        <a asp-controller="Participant"
           asp-action="Events"
           class="btn btn-success mt-4">
            Explore More Events
        </a>

        <a asp-controller="Participant"
           asp-action="Index"
           class="btn btn-secondary mt-4">
            Back to Dashboard
        </a>

    </main>

</body>
</html>
