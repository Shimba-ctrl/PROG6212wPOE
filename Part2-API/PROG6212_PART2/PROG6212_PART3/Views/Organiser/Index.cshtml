@{
    ViewData["Title"] = "Organiser Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RaceDay | Organiser Dashboard</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <a asp-controller="Results" asp-action="Manage"
       class="btn btn-primary">Manage Results</a>

          <style>
        body {
            background: #f4f7f8;
            font-family: Arial, sans-serif;
        }

        .navbar {
            background: #10243a;
            padding: 18px 35px;
        }

        .brand {
            color: white;
            font-size: 27px;
            font-weight: bold;
        }

        .welcome-section {
            background: linear-gradient(135deg, #176b63, #10243a);
            color: white;
            padding: 45px 35px;
        }

        .dashboard-content {
            padding: 35px;
        }

        .dashboard-card {
            background: white;
            border-radius: 14px;
            padding: 25px;
            height: 100%;
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
        }

            .dashboard-card h5 {
                color: #176b63;
                font-weight: bold;
            }

        .dashboard-icon {
            font-size: 30px;
            margin-bottom: 15px;
        }

        .footer {
            text-align: center;
            padding: 25px;
            color: #777;
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <span class="brand">RaceDay</span>
    </nav>

    <section class="welcome-section">
        <div class="container">
            <h1>Welcome, @ViewBag.FullName!</h1>
            <p class="lead mb-0">
                Manage your events. Organise the race. Make it happen.
            </p>
        </div>
    </section>

    <main class="container-fluid dashboard-content">
        <h3 class="mb-4">Organiser Dashboard</h3>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="dashboard-card">
                    <div class="dashboard-icon">🏁</div>
                    <h5>Manage Events</h5>
                    <p class="text-muted">Create, view, update and delete your race events.</p>
                    <a asp-controller="Events" asp-action="Index"
                       class="btn btn-primary">Manage Events</a>
                </div>
            </div>

            <div class="col-md-4">
                <div class="dashboard-card">
                    <div class="dashboard-icon">👥</div>
                    <h5>Manage Participants</h5>
                    <p class="text-muted">View event enrolments and participant information.</p>
                    <a asp-controller="Organiser" asp-action="Participants"
                       class="btn btn-primary">Manage Participants</a>
                </div>
            </div>

            <div class="col-md-4">
                <div class="dashboard-card">
                    <div class="dashboard-icon">🏆</div>
                    <h5>Manage Results</h5>
                    <p class="text-muted">Enter finishing times, positions and publish results.</p>
                    <a asp-controller="Organiser" asp-action="Results"
                       class="btn btn-primary">Manage Results</a>
                </div>
            </div>

            <div class="col-md-4">
                <div class="dashboard-card">
                    <div class="dashboard-icon">📋</div>
                    <h5>Manage Categories</h5>
                    <p class="text-muted">Create, view, update and delete categories for your events.</p>
                    <a asp-controller="Categories" asp-action="Index"
                       class="btn btn-primary">Manage Categories</a>
                </div>
            </div>
        </div>
    </main>

    <footer class="footer">
        © 2026 RaceDay. All rights reserved.
    </footer>
</body>
</html>
